          "type": "integer",
          "description": "Origin bar time in UTC seconds."
        },
        "confirmedAt": {
          "type": "integer",
          "description": "First bar time when the zone was knowable, in UTC seconds."
        },
        "observedAsOf": {
          "type": "integer",
          "description": "Last submitted bar time used to compute this snapshot, in UTC seconds."
        },
        "mitigatedWickAt": {
          "type": ["integer", "null"],
          "description": "First later bar whose wick met the library's mitigation rule, or null. Order blocks only."
        },
        "mitigatedCloseAt": {
          "type": ["integer", "null"],
          "description": "First later bar whose close crossed the zone in the invalidating direction, or null. Order blocks only."
        },
        "mitigatedWick": {
          "type": "boolean",
          "description": "Whether mitigatedWickAt is present. Order blocks only."
        },
        "mitigatedClose": {
          "type": "boolean",
          "description": "Whether mitigatedCloseAt is present. Order blocks only."
        },
        "touchCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of distinct later zone entries after the default five-bar settle window. Order blocks only."
        },
        "touchEvents": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "One-based offsets from candleIdx where each later contiguous zone entry began. Order blocks only."
        },
        "distancePct": {
          "type": "number",
          "description": "|reference - price| / price * 100."
        }
      },
      "required": [
        "type",
        "top",
        "bottom",
        "candleIdx",
        "time",
        "originAt",
        "confirmedAt",
        "observedAsOf",
        "distancePct"
