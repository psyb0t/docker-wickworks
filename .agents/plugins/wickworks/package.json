{
  "name": "@psyb0t/wickworks",
  "version": "0.0.0",
  "mcpName": "io.github.psyb0t/wickworks",
  "description": "Connect an OpenClaw/MCP agent to a self-hosted wickworks technical-analysis service over MCP.",
  "type": "module",
  "bin": {
    "wickworks-mcp": "bin/cli.js"
  },
  "files": [
    "bin",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "psyb0t",
  "homepage": "https://github.com/psyb0t/docker-wickworks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psyb0t/docker-wickworks.git"
  },
  "bugs": {
    "url": "https://github.com/psyb0t/docker-wickworks/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wickworks",
    "technical-analysis",
    "technical-indicators",
    "smart-money-concepts",
    "smc",
    "ohlc",
    "trading",
    "openclaw",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mcp-remote": "0.1.38"
  },
  "publishConfig": {
    "access": "public"
  },
  "openclaw": {
    "extensions": ["./bin/cli.js"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    }
  }
}
